# Copy to .env and fill in your values
#   cp .env.example .env

# ── Gemini API key ───────────────────────────────────────────────────────────
# Get a free key from Google AI Studio: https://aistudio.google.com/apikey
# (sign in with any Google account, click "Create API key" — no billing
# required for the free tier, which comfortably covers this demo).
# Generate your OWN key here — never reuse a key you've seen in a shared
# screen recording, chat log, or someone else's config; treat any key that's
# ever been pasted outside your own secrets manager as compromised and
# regenerate it.
#
# Paste just the key value after the "=" below — nothing else on this line:
GEMINI_API_KEY=

# ── Elastic — OTLP ingest ────────────────────────────────────────────────────
# This demo ships OTLP/HTTP directly to Elastic's own managed OTLP endpoint —
# NOT the raw Elasticsearch endpoint. In an Elastic Cloud Serverless
# Observability project, find both of these under
# Project settings → Manage this project → "Endpoints" (or the "Add data" /
# APM agent setup flow, which shows the exact OTLP endpoint + a matching key):
#   - OTEL_EXPORTER_OTLP_ENDPOINT: the project's managed OTLP endpoint
#   - ES_API_KEY: an API key scoped for ingest (the same flow usually issues one)
OTEL_EXPORTER_OTLP_ENDPOINT=https://<project-id>.ingest.<region>.elastic.cloud
ES_API_KEY=your-elastic-api-key-here

# Optional — only used to build clickable "open in Kibana APM" links in the
# chat UI and startup banner. Everything still works without it.
KIBANA_ENDPOINT=https://<project-id>.kb.<region>.elastic.cloud

# Required only for the docker-compose otel-collector service (container
# CPU/memory/log shipping) — same value as OTEL_EXPORTER_OTLP_ENDPOINT above.
# Not needed for running server.py/mcp_server.py directly.

# Self-hosted MCP tools server (web_agent/mcp_server.py) — no auth needed for
# this demo; run it alongside server.py (see README) or via docker-compose.
MCP_SERVER_URL=http://localhost:5603/mcp
MCP_PORT=5603

# Optional overrides
# Round-robin model pool — each new chat session gets the next model in order
# (comma-separated, no spaces around commas needed). Verify model names are
# currently available via https://generativelanguage.googleapis.com/v1beta/models
GEMINI_MODEL_POOL=gemini-3-flash-preview,gemini-3.1-flash-lite
PORT=5601

# Service identity — override if running multiple instances of this demo
# against the same Elastic backend, so they don't collide in the APM Service Map.
# SVC_NAME=gemini-demo-agent
# MCP_SVC_NAME=mcp-tools-server

# HOST_NAME=            # defaults to the machine's hostname
# METRICS_INTERVAL=30   # seconds between psutil/host-metric OTel exports
